[Unit]
Description=Tubeca worker (library scans, metadata scraping, file watching)
Documentation=https://github.com/wilkie/tubeca
After=network.target redis.service
Wants=redis.service

[Service]
# The service tells systemd when it is ready and keeps saying it is healthy;
# see WatchdogSec below and backend/src/runtime/systemd.ts.
Type=notify
NotifyAccess=main
User=tubeca
Group=tubeca
WorkingDirectory=/opt/tubeca/backend
EnvironmentFile=/opt/tubeca/backend/.env
ExecStart=/usr/bin/node --enable-source-maps dist/index.js
Restart=on-failure
RestartSec=5
# Restart when the process stops reporting that it can reach its database
# (and, for the worker, Redis), not only when it exits.
WatchdogSec=30
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tubeca/backend/prisma
ReadWritePaths=/opt/tubeca/data

# Environment
Environment=NODE_ENV=production
Environment=TUBECA_ROLE=worker
Environment=UV_THREADPOOL_SIZE=24

[Install]
WantedBy=multi-user.target
