[Unit]
Description=Tubeca API server (serves the web UI and the HTTP API)
Documentation=https://github.com/wilkie/tubeca
After=network.target redis.service
Wants=redis.service

[Service]
# The service tells systemd when it is ready and keeps saying it is healthy;
# see WatchdogSec below and backend/src/runtime/systemd.ts.
Type=notify
NotifyAccess=main
User=tubeca
Group=tubeca
WorkingDirectory=/opt/tubeca/backend
EnvironmentFile=/opt/tubeca/backend/.env
ExecStart=/usr/bin/node --enable-source-maps dist/index.js
Restart=on-failure
RestartSec=5
# Restart when the process stops reporting that it can reach its database
# (and, for the worker, Redis), not only when it exits.
WatchdogSec=30
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The database and its backups live in /var/lib/tubeca, which is state rather
# than program files; /opt/tubeca/data is the older location for media
# references and is kept writable for installs that still use it.
ReadWritePaths=/var/lib/tubeca
ReadWritePaths=/opt/tubeca/data

# Environment
Environment=NODE_ENV=production
Environment=TUBECA_ROLE=api
Environment=UV_THREADPOOL_SIZE=24
Environment=FRONTEND_DIST=/opt/tubeca/frontend/ui/dist

[Install]
WantedBy=multi-user.target
