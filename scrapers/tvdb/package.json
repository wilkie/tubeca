{
  "name": "@tubeca/scraper-tvdb",
  "version": "1.0.0",
  "description": "TVDB metadata scraper plugin for Tubeca",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
  },
  "dependencies": {
    "@tubeca/scraper-types": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@tubeca/scraper-types": "^1.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "tubeca": {
    "pluginType": "scraper"
  }
}
